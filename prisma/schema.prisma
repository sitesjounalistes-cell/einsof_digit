// Schéma adapté de la section 24 du cahier des charges.
// SQLite en sandbox (production visée : PostgreSQL + pgvector — voir docs/DECISIONS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  phone          String
  email          String?
  company        String?
  sector         String?
  message        String?
  // trial | quote | contact | chat | download | newsletter | demo
  source         String          @default("contact")
  // new | contacted | qualified | trial_or_demo | proposal | won | lost
  status         String          @default("new")
  interests      String?         // slugs séparés par des virgules
  locale         String          @default("fr")
  consentContact Boolean         @default(false)
  consentAt      DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  events   LeadEvent[]
  trials   TrialRequest[]
  messages ContactMessage[]
  demoBookings DemoBooking[]
}

model LeadEvent {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // created | status_changed | note | trial_requested | demo_requested | message
  type      String
  data      String?
  createdAt DateTime @default(now())
}

model TrialRequest {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  saasSlug  String
  // requested | activated | expired | converted | declined
  status    String   @default("requested")
  trialDays Int      @default(7)
  createdAt DateTime @default(now())

  @@unique([leadId, saasSlug])
}

model ContactMessage {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject   String?
  message   String
  // new | read | answered | archived
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(uuid())
  visitorId String
  locale    String        @default("fr")
  // text | omnis
  mode      String        @default("text")
  entryPath String?
  createdAt DateTime      @default(now())
  endedAt   DateTime?
  messages  ChatMessage[]
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // user | assistant | system
  role      String
  content   String?
  // -1 | 1 (retour utilisateur) ; null sinon
  feedback  Int?
  createdAt DateTime    @default(now())
}

model Consent {
  id        String   @id @default(uuid())
  visitorId String
  // cookies_analytics | chat_storage | microphone | contact
  type      String
  granted   Boolean
  locale    String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  props     String?
  path      String?
  locale    String?
  visitorId String?
  createdAt DateTime @default(now())
}

/* ── Journal (blog) — contenus éditoriaux de l'agence, JSON par locale ── */

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  /// {"fr":"…","en":"…"} — repli fr (spec §20.8)
  title       String
  excerpt     String
  /// Paragraphes séparés par \n\n, JSON par locale
  body        String
  /// saas | web | agence — clé libre affichée en badge
  category    String    @default("agence")
  readingMin  Int       @default(3)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /* ── SEO par article (dashboard) ── */
  /// Title SEO dédié (repli : title)
  metaTitle        String?
  /// Meta description dédiée (repli : excerpt)
  metaDescription  String?
  /// Mots-clés séparés par des virgules
  keywords         String?
  /* ── Espaces publicitaires insérés dans le contenu ── */
  /// [{"id":"…","title":"…","text":"…","imageUrl":"…","linkUrl":"…","ctaLabel":"…","position":2,"isActive":true}]
  adsJson     String    @default("[]")
}

/* ── Réalisations — infrastructure prête, section masquée tant que vide ── */

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique
  /// JSON par locale (repli fr)
  title       String
  client      String?
  sector      String?
  year        Int
  summary     String
  description String?
  linkUrl     String?
  /// URL de la capture d'écran (/uploads/… ou /images/works/…)
  imageUrl    String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ── Réglages éditables du site — page contact, mot du gérant (singleton) ── */

model SiteSettings {
  id         String   @id @default("singleton")
  /// ["+224 6…", "…"] — JSON array
  phonesJson  String  @default("[]")
  /// ["contact@…", "…"] — JSON array
  emailsJson  String  @default("[]")
  /// [{"platform":"facebook","label":"Facebook","url":"https://…"}] — JSON array
  socialsJson String  @default("[]")
  /// Photo du gérant (URL /uploads/… ou /images/…)
  managerPhotoUrl  String?
  managerPhotoAlt  String?
  /// {"fr":"…","en":"…"} — mot du gérant (2 paragraphes \n\n)
  managerMessageJson String?
  managerName   String?
  managerRole   String?
  updatedAt  DateTime @updatedAt
}

/* ── Liens par logiciel SaaS — démo en ligne + vidéo de présentation (YouTube) ── */

model SoftwareLink {
  slug      String   @id
  /// URL de la démo / instance du logiciel (bouton « Ouvrir le logiciel »)
  demoUrl   String?
  /// Lien YouTube de la vidéo de présentation (watch, youtu.be, shorts)
  videoUrl  String?
  updatedAt DateTime @updatedAt
}

/* ── Confiance — partenaires, témoignages, documents (spec §23/§24) ──
   Sections publiques masquées tant que rien n'est publié (règle §20.4). */

model Partner {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(uuid())
  authorName String
  authorRole String?
  company    String?
  sector     String?
  /// {"fr":"…","en":"…"} — repli fr (spec §20.8)
  quote      String
  /// 1-5, optionnel — affiché tel quel, jamais inventé
  rating      Int?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id          String   @id @default(uuid())
  slug        String   @unique
  /// JSON multi-langues (repli fr)
  title       String
  /// JSON multi-langues (repli fr)
  description String?
  /// clé libre affichée en badge
  category    String?
  /// lien réel fourni par le client (TODO-HUMAN H-08)
  fileUrl     String
  /// pdf | xlsx | docx | link
  fileKind    String?
  /// public | lead | team — seuls les documents "public" sont listés publiquement
  visibility  String   @default("public")
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ── Journal des e-mails transactionnels (adaptateur Resend / mock) ── */

model EmailLog {
  id        String   @id @default(uuid())
  toEmail   String
  subject   String
  /// contact_ack | trial_ack | custom
  template  String
  /// sent (Resend) | mock (journalisé, sandbox) | error
  status    String
  provider  String   @default("mock")
  error     String?
  leadId    String?
  createdAt DateTime @default(now())
}

/* ── Abonnements aux notifications push (web-push / VAPID) ── */

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String?
  visitorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ── Réglages serveur persistés (clés VAPID auto-générées, etc.) ── */

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/* ── Réservation de démonstration (spec §24) — fuseau Africa/Conakry (GMT+0) ── */

model DemoSlot {
  id        String        @id @default(uuid())
  startsAt  DateTime
  capacity  Int           @default(1)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bookings  DemoBooking[]
}

model DemoBooking {
  id        String   @id @default(uuid())
  slotId    String
  slot      DemoSlot @relation(fields: [slotId], references: [id])
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  saasSlug  String?
  // confirmed | cancelled | done | no_show
  status    String   @default("confirmed")
  locale    String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

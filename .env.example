# ── Exemple d'environnement EINSOF — copier vers .env et renseigner ─────
# Toutes les variables sont documentées ; seules DATABASE_URL et
# ADMIN_PASSWORD sont strictement obligatoires pour démarrer.

# Base SQLite (chemin relatif au dossier prisma/).
DATABASE_URL=file:../db/custom.db

# ── Obligatoire : accès Espace équipe (aucun mot de passe par défaut) ──
ADMIN_PASSWORD=

# ── Obligatoire en production : secret du cron /api/cron/maintenance ──
CRON_SECRET=

# ── Moteur conversationnel ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Identité ──
NEXT_PUBLIC_BRAND_NAME=EINSOF
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── E-mails (Resend) — sinon mode simulé journalisé ──
RESEND_API_KEY=
EMAIL_FROM=

# ── Push (VAPID) — sinon auto-générées et persistées en base ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── SEO (optionnel) ──
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
